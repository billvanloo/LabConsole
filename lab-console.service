[Unit]
Description=Lab Console - Bambu Lab fleet monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/lab-console
ExecStart=/home/pi/lab-console/.venv/bin/python /home/pi/lab-console/server.py /home/pi/lab-console/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
